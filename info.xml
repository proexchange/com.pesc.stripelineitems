<?xml version="1.0"?>
<extension key="com.pesc.stripelineitems" type="module">
  <file>stripelineitems</file>
  <name>com.pesc.stripelineitems</name>
  <description>Sync line items from civi to Stripe</description>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>Jose Torres</author>
    <email>itdept@pesc.com</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://github.com/proexchange/com.pesc.stripelineitems</url>
    <url desc="Documentation">https://github.com/proexchange/com.pesc.stripelineitems</url>
    <url desc="Support">https://github.com/proexchange/com.pesc.stripelineitems</url>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2023-04-26</releaseDate>
  <version>1.3</version>
  <develStage>alpha</develStage>
  <compatibility>
    <ver>5.0</ver>
  </compatibility>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <civix>
    <namespace>CRM/Stripelineitems</namespace>
    <format>23.02.1</format>
    <angularModule>crmStripelineitems</angularModule>
  </civix>
</extension>
